# GCP project and placement
project_id = "REPLACE_WITH_GCP_PROJECT_ID"
region     = "asia-south1"
zone       = "asia-south1-a"
name       = "multicloud-gcp"

# Networking
subnet_cidr = "10.60.1.0/24"
network_tags = ["multicloud-gcp-web"]

# Linux VM
machine_type        = "e2-micro"
boot_disk_image    = "debian-cloud/debian-12"
boot_disk_size_gb = 10
boot_disk_type     = "pd-balanced"
assign_public_ip   = true
web_page_title     = "GCP backend"

# HTTP ingress and health checks
http_source_ranges          = ["35.191.0.0/16", "130.211.0.0/22"]
health_check_source_ranges  = ["35.191.0.0/16", "130.211.0.0/22"]
ssh_source_ranges           = [] # Add your public IP /32 to enable SSH

http_port = 80
ssh_port  = 22

# Load balancer
lb_backend_port_name = "http"
lb_backend_port     = 80
lb_frontend_port    = 80
lb_health_check_path = "/"

# Windows Server VM
windows_machine_type       = "e2-standard-2"
windows_boot_disk_image   = "windows-cloud/windows-2022"
windows_boot_disk_size_gb = 50
windows_boot_disk_type    = "pd-balanced"

windows_data_disk_count   = 1
windows_data_disk_size_gb = 20
windows_data_disk_type    = "pd-balanced"

windows_assign_public_ip = true
windows_network_tag      = "multicloud-gcp-windows"

windows_rdp_source_ranges = [] # Add your public IP /32 to enable RDP